# Datum Atelier on Apache or LiteSpeed (MilesWeb cPanel and similar).
# Copied into dist/ by the build. It is a hidden file: make sure it is uploaded too.
# Every block is guarded, so a host without a module simply skips that block.

Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

# ---- HTTPS and the bare domain -------------------------------------------------
# Safe behind Cloudflare: it sends X-Forwarded-Proto, so there is no redirect loop
# even in Cloudflare's "Flexible" SSL mode.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP_HOST} ^www\.datumatelier\.uk$ [NC]
  RewriteRule ^ https://datumatelier.uk%{REQUEST_URI} [R=301,L]
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteCond %{HTTP_HOST} ^datumatelier\.uk$ [NC]
  RewriteRule ^ https://datumatelier.uk%{REQUEST_URI} [R=301,L]
</IfModule>

# ---- types -----------------------------------------------------------------------
<IfModule mod_mime.c>
  AddType font/woff2 .woff2
  AddType image/webp .webp
  AddType image/svg+xml .svg
  AddType model/gltf-binary .glb
  AddType application/xml .xml
  AddType text/javascript .js .mjs
</IfModule>

# ---- compression -----------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json application/xml image/svg+xml model/gltf-binary
</IfModule>

# ---- caching ---------------------------------------------------------------------
<IfModule mod_headers.c>
  # pages: always check for a new version
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  # scripts and styles without a content hash in the name: an hour
  <FilesMatch "^(site\.css|pages\.css|pages\.js|film\.js|instrument\.js|invite\.js)$">
    Header set Cache-Control "public, max-age=3600"
  </FilesMatch>
  # the build's hashed files (name-AbCd1234.js): never change, cache for a year
  <FilesMatch "-[A-Za-z0-9_-]{8}\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # fonts, photographs, icons, a car model: a month
  <FilesMatch "\.(woff2|webp|jpg|jpeg|png|svg|ico|glb)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>

  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
</IfModule>
